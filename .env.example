# HOMEBASE Environment Configuration Example
# Copy to .env.local for Private Family Sync Mode (Mode B) or optional hosted AI/OCR.
# Mode A (Local Private Mode) requires zero environment variables and works 100% offline.

# Optional: Supabase Backend for Mode B (Private Family Sync Mode)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Server-Side AI Proxy Endpoint (Never expose raw provider API keys in frontend bundles)
VITE_AI_PROXY_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/homebase-ai-assistant
VITE_LOCAL_OLLAMA_URL=http://127.0.0.1:11434

# Optional: Home Assistant Local Integration Boundary (Disabled by default)
VITE_HA_DEFAULT_DISABLED=true
